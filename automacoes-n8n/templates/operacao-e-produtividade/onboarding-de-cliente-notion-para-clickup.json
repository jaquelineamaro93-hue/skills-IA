    {
      "parameters": {
        "jsCode": "const results = $input.first().json.results || [];\n\nfunction richTextToPlainText(richText = []) {\n  return richText.map(item => item.plain_text || \"\").join(\"\");\n}\n\nfunction blockToText(block) {\n  const type = block.type;\n  const value = block[type];\n\n  if (!value) return \"\";\n\n  switch (type) {\n    case \"heading_1\":\n    case \"heading_2\":\n    case \"heading_3\":\n      return richTextToPlainText(value.rich_text);\n\n    case \"paragraph\":\n      return richTextToPlainText(value.rich_text);\n\n    case \"bulleted_list_item\":\n      return `- ${richTextToPlainText(value.rich_text)}`;\n\n    case \"numbered_list_item\":\n      return `1. ${richTextToPlainText(value.rich_text)}`;\n\n    case \"to_do\":\n      return `${value.checked ? \"[x]\" : \"[ ]\"} ${richTextToPlainText(value.rich_text)}`;\n\n    case \"quote\":\n      return `> ${richTextToPlainText(value.rich_text)}`;\n\n    case \"callout\":\n      return `> ${richTextToPlainText(value.rich_text)}`;\n\n    case \"divider\":\n      return \"---\";\n\n    default:\n      return \"\";\n  }\n}\n\nlet titulo = \"\";\nconst conteudo = [];\n\nfor (const block of results) {\n  if (!titulo && block.type?.startsWith(\"heading\")) {\n    titulo = richTextToPlainText(block[block.type]?.rich_text || []);\n    continue;\n  }\n\n  const text = blockToText(block);\n  if (text) conteudo.push(text);\n}\n\nconst conteudoTexto = conteudo.join(\"\\n\\n\");\n\nreturn [\n  {\n    json: {\n      titulo,\n      conteudo: conteudoTexto,\n\n      // Use este campo no HTTP Request quando precisar enviar dentro de JSON manual\n      conteudo_json: JSON.stringify(conteudoTexto),\n      titulo_json: JSON.stringify(titulo),\n    },\n  },\n];"
      },
      "type": "n8n-nodes-base.code",
      "typeVersion": 2,
