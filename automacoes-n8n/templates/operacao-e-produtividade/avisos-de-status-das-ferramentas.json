        180
      ],
      "id": "nota_-_entrada"
    },
    {
      "parameters": {
        "content": "### NORMALIZA — Edit Fields\nExtrai url, status_indicator, id/nome/status do componente e new_status.\nO campo `Webhook` define o destino: troque por `SUA_URL_ORQUESTRADOR`.",
        "height": 200,
