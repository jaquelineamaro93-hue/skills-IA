              "name": "user_data.email",
              "value": "={{ /* Remove spaces and make lowercase */\n\n$('Definir Campos2').first().json.email.trim().toLowerCase()\n\n}}",
              "type": "string"
            },
            {
              "id": "65d1994d-f4b8-478a-8cf1-490990e6639d",
              "name": "user_data.phone",
              "value": "={{ \n  (\n     $('Definir Campos2').first().json.phone\n      ? $('Definir Campos2').first().json.phone.replace(/\\D/g, '').replace(/^0+/, '') \n      : ''\n  ) || '' \n}}\n\n\n}}",
